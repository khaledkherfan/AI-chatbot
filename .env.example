# Copy to .env and fill in values.

# OpenAI — required for chat, vision, embeddings, and extraction
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDINGS_MODEL=text-embedding-3-small

# Required in production — use a long random string
JWT_SECRET=
JWT_EXPIRY_DAYS=30

# SQLite database (users + chat messages). Directory is created if missing.
DATABASE_PATH=instance/just_app.db

REDIS_HOST=localhost
REDIS_PORT=6379

# Academic calendar — if WAF blocks server fetches, paste Cookie from browser (curl -H 'Cookie: ...')
# Default page: https://www.just.edu.jo/calendar/Pages/default.aspx
# Derive CALENDAR_PAGE_URL / REFERER / HTML_FILE from a saved page (e.g. test.html):
#   python scripts/calendar_env_from_html.py test.html
# CALENDAR_REQUEST_COOKIE=
# CALENDAR_REQUEST_REFERER=https://www.just.edu.jo/
# CALENDAR_HTML_FILE=test.html
